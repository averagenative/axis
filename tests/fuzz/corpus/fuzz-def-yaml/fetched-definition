---
# A made-up definition in the shape of the files in Jackett's repository, as
# one fetched from there would arrive: a private site with a login form and
# the keys a public site's definition does not use.
id: madeupprivate
name: Made Up Private
description: "A made-up private site, for the fuzz corpus"
language: en-US
type: private
encoding: UTF-8
requestDelay: 2
followredirect: true
links:
  - https://madeupprivate.invalid/
legacylinks:
  - https://old.madeupprivate.invalid/

caps:
  categorymappings:
    - {id: 10, cat: Movies/HD, desc: "Movies HD"}
    - {id: 11, cat: Movies/UHD, desc: "Movies UHD"}
    - {id: 20, cat: TV/HD, desc: "TV HD"}
    - {id: 30, cat: Audio/MP3, desc: "Music"}
  modes:
    search: [q]
    tv-search: [q, season, ep, imdbid]
    movie-search: [q, imdbid]
    music-search: [q, artist, album]
  allowrawsearch: true

settings:
  - name: username
    type: text
    label: Username
  - name: password
    type: password
    label: Password
  - name: freeleech
    type: checkbox
    label: Search freeleech only
    default: false
  - name: sort
    type: select
    label: Sort requested from site
    default: added
    options:
      added: created
      seeders: seeders
  - name: info_tpp
    type: info
    label: Results Per Page
    default: "For best results, change the Torrents per page setting to 100."

login:
  path: login.php
  method: form
  form: form[action="takelogin.php"]
  inputs:
    username: "{{ .Config.username }}"
    password: "{{ .Config.password }}"
    logout: ""
  error:
    - selector: td.embedded:has(h2:contains("failed"))
  test:
    path: index.php
    selector: a[href="logout.php"]

ratio:
  path: index.php
  selector: span.ratio

search:
  paths:
    - path: browse.php
      categories: [10, 11]
    - path: tv.php
      categories: [20]
      inheritinputs: false
      response:
        type: html
  inputs:
    $raw: "{{ range .Categories }}c{{.}}=1&{{end}}"
    search: "{{ if .Query.IMDBID }}{{ .Query.IMDBID }}{{ else }}{{ .Keywords }}{{ end }}"
    incldead: 1
    free: "{{ if .Config.freeleech }}1{{ else }}0{{ end }}"
    sort: "{{ .Config.sort }}"
  keywordsfilters:
    - name: re_replace
      args: ["[^a-zA-Z0-9]+", "%"]
  error:
    - selector: div.error
      message:
        selector: div.error > p
  rows:
    selector: table.torrents > tbody > tr:has(a[href^="details.php?id="])
    after: 1
    dateheaders:
      selector: td.colhead
      filters:
        - name: dateparse
          args: "yyyy-MM-dd"
  fields:
    category:
      selector: a[href^="browse.php?cat="]
      attribute: href
      filters:
        - name: querystring
          args: cat
    title:
      selector: a[href^="details.php?id="]
      attribute: title
    details:
      selector: a[href^="details.php?id="]
      attribute: href
    download:
      selector: a[href^="download.php"]
      attribute: href
    imdbid:
      optional: true
      selector: a[href*="imdb.com/title/tt"]
      attribute: href
    size:
      selector: td:nth-child(6)
    grabs:
      selector: td:nth-child(7)
      filters:
        - name: regexp
          args: "(\\d+)"
    seeders:
      selector: td:nth-child(8)
    leechers:
      selector: td:nth-child(9)
    date:
      selector: td:nth-child(5) > span
      attribute: title
      filters:
        - name: append
          args: " +00:00"
        - name: dateparse
          args: "yyyy-MM-dd HH:mm:ss zzz"
    downloadvolumefactor:
      case:
        img[alt="Free"]: 0
        img[alt="Half"]: 0.5
        "*": 1
    uploadvolumefactor:
      case:
        img[alt="2x"]: 2
        "*": 1
    minimumratio:
      text: 1.0
    minimumseedtime:
      # 2 days (as seconds = 2 x 24 x 60 x 60)
      text: 172800

download:
  before:
    path: thanks.php
    method: post
    inputs:
      id: "{{ .DownloadUri.Query.id }}"
  selectors:
    - selector: a[href^="download.php"]
      attribute: href
